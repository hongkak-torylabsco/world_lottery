{
  "name": "world-lottery-feedback-retention",
  "main": "index.js",
  "compatibility_date": "2026-11-22",
  "workers_dev": false,
  "preview_urls": false,
  "triggers": { "crons": ["0 * * * *"] },
  "observability": {
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false }
  },
  "d1_databases": [{
    "binding": "FEEDBACK_DB",
    "database_name": "world-lottery-feedback-local",
    "database_id": "18000000-0000-4000-8000-000000000001",
    "migrations_dir": "../../migrations"
  }]
}
